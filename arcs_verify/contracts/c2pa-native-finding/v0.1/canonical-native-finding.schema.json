{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arcs.c2pa_native_finding.canonical_native_finding.v0.1",
  "title": "Canonical C2PA native finding",
  "description": "One side of a C2PA native evaluation, normalized into per-axis findings. The same shape carries an observation supplied by a producer and a recomputation performed by arcs-verify. Which side it is, is a property of where it sits in the report, never of this object.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "side",
    "validator",
    "inputs",
    "settings",
    "trust_basis",
    "validation_clock",
    "evaluation_status",
    "axes"
  ],
  "properties": {
    "side": {
      "enum": ["observed", "recomputed"],
      "description": "observed: asserted by a producer or third party; carries no independent weight. recomputed: produced by arcs-verify invoking the pinned native validator over frozen inputs."
    },
    "evidence_class": {
      "enum": [
        "live_native_invocation",
        "replayed_frozen_native_report",
        "supplied_producer_assertion"
      ],
      "description": "How this side's bytes came to exist. replayed_frozen_native_report is a recorded output of a prior arcs-verify invocation of the pinned validator, replayed for hermetic test execution; it is NOT a fresh independent recomputation and must not be presented as one."
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version"],
      "properties": {
        "implementation": {"type": "string"},
        "version": {"type": "string"},
        "source": {"type": "string"},
        "install_command": {"type": "string"},
        "c2pa_specification_version": {"type": "string"}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_digest", "manifest_acquisition_mode"],
      "properties": {
        "asset_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "asset_bytes": {"type": "integer", "minimum": 0},
        "manifest_store_digest": {
          "oneOf": [
            {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            {"type": "null"}
          ],
          "description": "Digest of the manifest-store bytes when they were supplied as separate bytes. Null when the store is embedded and was not separately extracted."
        },
        "manifest_acquisition_mode": {
          "enum": ["embedded", "remote_reference", "external_supplied", "sidecar", "durable_recovery"]
        },
        "remote_manifest_uri": {"type": ["string", "null"]},
        "unresolved_inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input", "reason"],
            "properties": {
              "input": {"type": "string"},
              "reason": {"type": "string"},
              "uri": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["settings_digest", "hermeticity"],
      "properties": {
        "settings_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "remote_manifest_fetch": {"type": "boolean"},
        "ocsp_fetch": {"type": "boolean"},
        "verify_trust": {"type": "boolean"},
        "verify_timestamp_trust": {"type": "boolean"},
        "allowed_network_hosts": {"type": "array", "items": {"type": "string"}},
        "hermeticity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "network_access_permitted",
            "remote_resource_fetch_attempted",
            "trust_list_uri_dereferenced",
            "ocsp_fetch_permitted"
          ],
          "properties": {
            "network_access_permitted": {"type": "boolean"},
            "remote_resource_fetch_attempted": {"type": "boolean"},
            "trust_list_uri_dereferenced": {"type": "boolean"},
            "ocsp_fetch_permitted": {"type": "boolean"},
            "remote_resource_required_but_unavailable": {"type": "boolean"}
          }
        }
      }
    },
    "trust_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["default", "anchors_supplied", "allowed_list_supplied", "trust_disabled"]
        },
        "material_digest": {
          "oneOf": [
            {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            {"type": "null"}
          ],
          "description": "Digest of the actual trust-material bytes. A trust-list name or URI is not an acceptable substitute: the bytes are the input to the finding."
        },
        "material_source": {"type": ["string", "null"]},
        "material_source_pin": {"type": ["string", "null"]},
        "on_official_c2pa_trust_list": {
          "enum": ["not_established"],
          "description": "Constrained to not_established. No fixture in this bundle chains to the official public C2PA trust list; trust-by-supplied-allowed-list is a different claim and is the only one evidenced here."
        }
      }
    },
    "validation_clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "caller_pinnable"],
      "properties": {
        "source": {"enum": ["wall_clock"]},
        "caller_pinnable": {
          "const": false,
          "description": "The pinned native validator exposes no validation-clock control anywhere in its settings hierarchy. Hermetic execution does not make the validation instant pinnable."
        },
        "instant": {"type": ["string", "null"]},
        "anchored_by_trusted_timestamp": {"type": "boolean"}
      }
    },
    "evaluation_status": {
      "enum": ["evaluated", "input_unavailable", "invocation_error"],
      "description": "Derived from the machine report, never from process exit status. input_unavailable means a required input could not be supplied; it is not a validation failure."
    },
    "evaluation_status_detail": {"type": ["string", "null"]},
    "native_validation_state": {
      "oneOf": [{"enum": ["Trusted", "Valid", "Invalid"]}, {"type": "null"}],
      "description": "Recorded verbatim as a native field. It is NOT an arcs-verify verdict and MUST NOT be promoted to one: the pinned validator emits Valid simultaneously with a signingCredential.untrusted failure."
    },
    "native_report_digest": {
      "oneOf": [{"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, {"type": "null"}]
    },
    "axes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["axis", "status", "reproducibility_class"],
        "properties": {
          "axis": {
            "enum": [
              "manifest_structure",
              "asset_binding",
              "claim_signature",
              "signer_trust",
              "signer_validity",
              "timestamp",
              "revocation",
              "ingredient"
            ]
          },
          "status": {
            "enum": ["satisfied", "failed", "indeterminate", "not_evaluated", "not_applicable"]
          },
          "status_reason": {"type": ["string", "null"]},
          "reproducibility_class": {
            "enum": [
              "byte_deterministic",
              "policy_dependent",
              "time_dependent",
              "resource_dependent",
              "validator_version_dependent"
            ]
          },
          "contributing_reproducibility_classes": {
            "type": "array",
            "items": {
              "enum": [
                "byte_deterministic",
                "policy_dependent",
                "time_dependent",
                "resource_dependent",
                "validator_version_dependent"
              ]
            }
          },
          "native_findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "severity", "scope"],
              "properties": {
                "code": {"type": "string"},
                "severity": {"enum": ["success", "informational", "failure"]},
                "scope": {"enum": ["activeManifest", "ingredientDeltas"]},
                "url": {"type": ["string", "null"]},
                "ingredient_assertion_uri": {"type": ["string", "null"]}
              }
            }
          }
        }
      }
    },
    "unmapped_native_codes": {
      "type": "array",
      "description": "Native codes the pinned taxonomy does not map to an axis. Surfaced rather than dropped: an unmapped code is how validator drift becomes visible instead of silently disappearing.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "scope"],
        "properties": {
          "code": {"type": "string"},
          "severity": {"enum": ["success", "informational", "failure"]},
          "scope": {"enum": ["activeManifest", "ingredientDeltas"]},
          "url": {"type": ["string", "null"]}
        }
      }
    }
  }
}
