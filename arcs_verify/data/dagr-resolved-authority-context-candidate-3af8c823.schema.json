{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dagr.spec/schemas/candidates/resolved-authority-context.v0.1.schema.json",
  "title": "DAGR ResolvedAuthorityContext v0.1 Candidate",
  "description": "Candidate action-domain cross-repository binding of one independently resolved governed operator-authority context to one exact canonical ProposedTransaction. The operator resolver is action-independent; this object records context and binding only. It is not an action permission, Countervail decision, execution authorization, execution record, or verification result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "domain",
    "transaction_id",
    "transaction_digest",
    "operator_identity_ref",
    "authority_profile_ref",
    "review_roles",
    "authority_source",
    "authority_provenance",
    "authority_context_digest"
  ],
  "properties": {
    "schema": {
      "const": "dagr.resolved-authority-context-candidate/v0.1"
    },
    "domain": {
      "const": "action"
    },
    "transaction_id": {
      "$ref": "#/$defs/transaction_id"
    },
    "transaction_digest": {
      "$ref": "#/$defs/digest"
    },
    "operator_identity_ref": {
      "type": "string",
      "minLength": 1
    },
    "authority_profile_ref": {
      "type": "string",
      "enum": [
        "approver",
        "editor",
        "viewer"
      ]
    },
    "review_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "approver",
          "auditor"
        ]
      },
      "uniqueItems": true,
      "maxItems": 2
    },
    "authority_source": {
      "const": "operator_authority_profile"
    },
    "authority_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "genesis_id",
        "genesis_digest",
        "status",
        "effective_from",
        "authority_source_ref",
        "supporting_review_ref"
      ],
      "properties": {
        "genesis_id": {
          "const": "dagr-merit-operator-authority-v0.1"
        },
        "genesis_digest": {
          "$ref": "#/$defs/digest"
        },
        "status": {
          "const": "active"
        },
        "effective_from": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "authority_source_ref": {
          "type": "string",
          "minLength": 1
        },
        "supporting_review_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authority_context_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "authority_profile_ref": {
            "const": "approver"
          }
        },
        "required": [
          "authority_profile_ref"
        ]
      },
      "then": {
        "properties": {
          "review_roles": {
            "const": [
              "approver",
              "auditor"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authority_profile_ref": {
            "const": "editor"
          }
        },
        "required": [
          "authority_profile_ref"
        ]
      },
      "then": {
        "properties": {
          "review_roles": {
            "const": [
              "auditor"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authority_profile_ref": {
            "const": "viewer"
          }
        },
        "required": [
          "authority_profile_ref"
        ]
      },
      "then": {
        "properties": {
          "review_roles": {
            "const": []
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "transaction_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    }
  },
  "x_dagr_candidate_contract": {
    "ratification_status": "PENDING",
    "authority_movement": 0,
    "permission": "not conferred",
    "execution_authorization": "not conferred",
    "execution": "not conferred",
    "semantic_owner": "DAGR constitutional binding only",
    "action_domain_owner": "Countervail",
    "emitter_owner": "dagr-runtime",
    "production_provenance_source": "dagr_runtime.ingress.operator_authority_provision.VerifiedOperatorAuthorityGenesis",
    "provenance_binding": "schema validity is necessary but insufficient: producer/verifier MUST prove operator_identity_ref, authority_profile_ref, and every authority_provenance member match the same verified governed genesis object",
    "failure_semantics": "no ResolvedAuthorityContext artifact is emitted when governed operator-authority provenance or operator authority cannot be lawfully resolved",
    "candidate_to_canonical_digest": "MUST_REMINT because schema identity and canonical digest preimage prefix change at ratification"
  }
}
