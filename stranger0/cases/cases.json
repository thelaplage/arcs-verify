{
  "schema": "arcs.verify.stranger0.cases.v0.1",
  "path_prefixes": {
    "pinned:": "packs/srs.mcp.sdk_enforcement/v0.1/normative/",
    "case:": "stranger0/cases/"
  },
  "families": {
    "body_tamper_after_signing": "A receipt whose signed content was changed after signing is reported with signature_invalid and nothing else failing; the receiver does not rely on it.",
    "wrong_key": "A receipt signed by a key other than the one its key_id names, or naming a key id the receiver does not hold, is not relied upon.",
    "self_trust_embedded_key": "A receipt cannot vouch for its own key: a validly signed receipt carrying its own public key is not relied upon unless the receiver's own trust input holds that key.",
    "trust_input_variants": "The same receipt bytes yield different verifier findings under different receiver-supplied keys: with no anchors, or with the key marked untrusted by the receiver, there is no reliance even though the signature may verify.",
    "unknown_version_profile": "A receipt with an unknown receipt_version or an unregistered profile is not relied upon, with both verifier findings and receiver policy reasons shown.",
    "chain_link": "An outcome receipt whose admission receipt is absent yields insufficient evidence; one whose linkage is inconsistent is not relied upon; an intact pair is.",
    "duplicate_replay": "A repeated, previously relied-upon, or id-conflicting receipt is not relied upon a second time.",
    "refused_deferred_honesty": "Refused and deferred dispositions are represented as what they are and never dropped, even beside a receipt that fails.",
    "metadata_only_violation": "A validly signed receipt that carries raw arguments, results or credential-shaped content fails raw_content_exclusion while its signature stays valid.",
    "valid_but_declined": "A receipt that passes every verifier check can still be declined by the receiver under its own policy: verifier pass is necessary, not sufficient.",
    "input_integrity": "Bytes that are not a JSON object produce no verifier findings (not a pass) and no reliance.",
    "controls": "Positive controls and counterfactual controls shared by the families above.",
    "dependent_admission_reliance": "Under the strict receiver policy, an outcome receipt is relied upon only if this receiver also relied on the admission receipt it references. Arrival of the referenced receipt, a matching receipt id, or the receipt-set linker's own finding is not enough. The arrival-only reading stays reachable as an explicit counterfactual policy."
  },
